{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@lib/tracing": ["../../lib/tracing/index.ts"],
      "@lib/tracing/helpers": ["../../lib/tracing/helpers.ts"],
      "@lib/brand": ["../../lib/brand/brand.ts"],
      "@lib/brand/*": ["../../lib/brand/*.ts"],
      "@lib/goat-query": ["../../lib/goat-query/index.ts"],
      "@lib/goat-query/react": ["../../lib/goat-query/react.ts"],
      "@lib/goat-query/devtools": ["../../lib/goat-query/devtools/index.ts"],
      "@lib/performance-monitor": ["../../lib/performance-monitor/index.ts"],
      "@lib/rsc-prism": ["../../lib/rsc-prism/src/index.ts"],
      "@lib/rsc-prism/react": ["../../lib/rsc-prism/src/react.tsx"],
      "@lib/rsc-prism/*": ["../../lib/rsc-prism/src/*"]
    }
  },
  "include": ["src", "../../lib/**/*.ts", "../../lib/**/*.tsx"]
}
