    "@types/react-is": "19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260122.3",
    "@vitejs/plugin-react": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "oxlint-tsgolint": "0.11.1",
    "tailwindcss": "4.1.17",
