{
  "name": "movies-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit --isolatedDeclarations",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui"
  },
  "dependencies": {
    "@lib/brand": "workspace:*",
