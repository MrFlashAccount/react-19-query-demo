{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:ui": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:e2e:ui": {
      "cache": false
    },
    "check": {
      "dependsOn": ["check:type", "check:lint", "check:format"],
      "outputs": []
    },
    "check:type": {
      "dependsOn": ["^check:type"],
      "outputs": []
    },
    "check:lint": {
      "outputs": []
    },
    "check:format": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
