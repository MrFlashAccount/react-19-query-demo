{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel:single",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/movies-db/api/:path*",
      "destination": "/movies-db/api/:path*"
    },
    {
      "source": "/movies-db/rsc/:path*",
      "destination": "/movies-db/rsc/:path*"
    },
    {
      "source": "/movies-db",
      "destination": "/movies-db/index.html"
    },
    {
      "source": "/movies-db/",
      "destination": "/movies-db/index.html"
    },
    {
      "source": "/movies-db/:path((?!.*\\.).*)",
      "destination": "/movies-db/index.html"
    },
    {
      "source": "/monitoring-dashboard/api/:path*",
      "destination": "/monitoring-dashboard/api/:path*"
    },
    {
      "source": "/monitoring-dashboard/rsc/:path*",
      "destination": "/monitoring-dashboard/rsc/:path*"
    },
    {
      "source": "/monitoring-dashboard",
      "destination": "/monitoring-dashboard/index.html"
    },
    {
      "source": "/monitoring-dashboard/",
      "destination": "/monitoring-dashboard/index.html"
    },
    {
      "source": "/monitoring-dashboard/:path((?!.*\\.).*)",
      "destination": "/monitoring-dashboard/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
