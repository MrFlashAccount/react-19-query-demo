{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vite/client", "node"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "./dist",
    "./node_modules",
    "./test",
    "./**/__tests__/**",
    "./**/*.test.*",
    "./tsdown.config.ts"
  ]
}
