{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vite/client", "node"],
    "paths": {
      "@lib/tracing": ["../tracing/dist/index.d.ts"],
      "@lib/tracing/helpers": ["../tracing/dist/helpers.d.ts"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "./dist",
    "./node_modules",
    "./test",
    "./**/__tests__/**",
    "./**/*.test.*",
    "./tsdown.config.ts"
  ]
}
