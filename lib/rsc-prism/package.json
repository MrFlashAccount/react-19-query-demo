{
  "name": "@lib/rsc-prism",
  "version": "0.0.0",
  "description": "Environment-agnostic React Server Components core primitives and transport helpers.",
  "keywords": [
    "react-server-components",
    "rsc",
    "flight",
    "transport",
    "web"
  ],
  "homepage": "https://github.com/MrFlashAccount/react-19-query-demo#readme",
  "bugs": {
    "url": "https://github.com/MrFlashAccount/react-19-query-demo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrFlashAccount/react-19-query-demo.git",
    "directory": "lib/rsc-prism"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "default": "./dist/client-only.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./response": {
      "types": "./dist/response.d.ts",
      "default": "./dist/response.js"
    },
    "./polyfill": {
      "types": "./dist/polyfill.d.ts",
      "default": "./dist/polyfill.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./client-reference": {
      "types": "./dist/client-reference.d.ts",
      "default": "./dist/client-reference.js"
    },
    "./flight-serializer": {
      "types": "./dist/flight-serializer.d.ts",
      "default": "./dist/flight-serializer.js"
    },
    "./runtime/webpack-shim": {
      "types": "./dist/runtime/webpack-shim.d.ts",
      "default": "./dist/runtime/webpack-shim.js"
    },
    "./runtime/module-registry": {
      "types": "./dist/runtime/module-registry.d.ts",
      "default": "./dist/runtime/module-registry.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  },
  "dependencies": {
    "react-server-dom-webpack": "catalog:",
    "web-streams-polyfill": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.0.9",
    "@vitest/coverage-istanbul": "4.0.9",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "1.50.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}