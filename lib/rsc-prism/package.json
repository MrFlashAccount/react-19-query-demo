{
  "name": "@lib/rsc-prism",
  "version": "0.0.0",
  "description": "Environment-agnostic React Server Components core primitives and transport helpers.",
  "keywords": [
    "flight",
    "react-server-components",
    "rsc",
    "transport",
    "web"
  ],
  "homepage": "https://github.com/MrFlashAccount/react-19-query-demo#readme",
  "bugs": {
    "url": "https://github.com/MrFlashAccount/react-19-query-demo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrFlashAccount/react-19-query-demo.git",
    "directory": "lib/rsc-prism"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "default": "./dist/client-only.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./response": {
      "types": "./dist/response.d.ts",
      "default": "./dist/response.js"
    },
    "./polyfill": {
      "types": "./dist/polyfill.d.ts",
      "default": "./dist/polyfill.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./client-reference": {
      "types": "./dist/client-reference.d.ts",
      "default": "./dist/client-reference.js"
    },
    "./flight-serializer": {
      "types": "./dist/flight-serializer.d.ts",
      "default": "./dist/flight-serializer.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./runtime/module-registry": {
      "types": "./dist/runtime/module-registry.d.ts",
      "default": "./dist/runtime/module-registry.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "perf:decode": "RSC_PERF=1 vitest run --project unit test/perf/flight-runtime.decode-perf.unit.test.ts",
    "perf:deopt": "node test/perf/run-deopt-sample.mjs",
    "perf:deopt:parse": "node test/perf/parse-deopt-log.mjs --input /tmp/rsc-prism-deopt-sample.latest.log --output test/perf/results/deopt-sample-latest.md",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write",
    "dev:integration": "vite --config test/integration/TodoMVC/vite.config.ts",
    "build:integration": "vite build --config test/integration/TodoMVC/vite.config.ts",
    "build:integration:analyze": "BUNDLE_ANALYZE=true vite build --config test/integration/TodoMVC/vite.config.ts && mv -f bundle-analysis.html test/integration/TodoMVC/dist/bundle-analysis.html",
    "test:e2e": "pnpm exec playwright test -c test/integration/TodoMVC/playwright.config.ts",
    "test:e2e:ui": "pnpm exec playwright test -c test/integration/TodoMVC/playwright.config.ts --ui"
  },
  "dependencies": {
    "@lib/tracing": "workspace:*",
    "@babel/parser": "^7.29.0",
    "web-streams-polyfill": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "4.0.9",
    "@vitest/coverage-istanbul": "4.0.9",
    "babel-plugin-react-compiler": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "1.50.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "6.1.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "1.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0-beta.0"
  },
  "engines": {
    "node": ">=20"
  }
}
