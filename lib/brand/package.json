{
  "name": "@lib/brand",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/brand.js",
  "types": "./dist/brand.d.ts",
  "exports": {
    ".": {
      "types": "./dist/brand.d.ts",
      "default": "./dist/brand.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "default": "./dist/standard-schema.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  }
}
