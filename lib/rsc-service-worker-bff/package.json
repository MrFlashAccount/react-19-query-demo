{
  "name": "@lib/rsc-service-worker-bff",
  "version": "0.0.0",
  "description": "Service worker backend-for-frontend toolkit with React Server Components support.",
  "keywords": [
    "bff",
    "react-server-components",
    "rsc",
    "service-worker",
    "web"
  ],
  "homepage": "https://github.com/MrFlashAccount/react-19-query-demo#readme",
  "bugs": {
    "url": "https://github.com/MrFlashAccount/react-19-query-demo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrFlashAccount/react-19-query-demo.git",
    "directory": "lib/rsc-service-worker-bff"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "default": "./dist/rsc/index.js"
    },
    "./rsc/client-only": {
      "types": "./dist/rsc/client-only.d.ts",
      "default": "./dist/rsc/client-only.js"
    },
    "./rsc/webpack-shim": {
      "types": "./dist/rsc/webpack-shim.d.ts",
      "default": "./dist/rsc/webpack-shim.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/browser-playwright": "4.0.9",
    "@vitest/coverage-istanbul": "4.0.9",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "1.50.1",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}