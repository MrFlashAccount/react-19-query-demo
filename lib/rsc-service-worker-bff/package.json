{
  "name": "@lib/rsc-service-worker-bff",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "default": "./dist/rsc/index.js"
    },
    "./rsc/*": {
      "types": "./dist/rsc/*.d.ts",
      "default": "./dist/rsc/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  },
  "dependencies": {
    "react-is": "^19.0.0",
    "react-server-dom-webpack": "^19.1.0",
    "web-streams-polyfill": "^4.1.0"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "typescript": "5.9.3",
    "tsdown": "0.20.1",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "oxlint-tsgolint": "0.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}