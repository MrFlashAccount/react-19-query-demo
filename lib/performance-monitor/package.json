{
  "name": "@lib/performance-monitor",
  "version": "0.0.0",
  "description": "Runtime performance observer and overlay for browser applications.",
  "keywords": [
    "browser",
    "monitoring",
    "overlay",
    "performance",
    "web-vitals"
  ],
  "homepage": "https://github.com/MrFlashAccount/react-19-query-demo#readme",
  "bugs": {
    "url": "https://github.com/MrFlashAccount/react-19-query-demo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrFlashAccount/react-19-query-demo.git",
    "directory": "lib/performance-monitor"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  },
  "dependencies": {
    "lit-html": "catalog:"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
