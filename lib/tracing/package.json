{
  "name": "@lib/tracing",
  "version": "0.0.0",
  "description": "Tracing primitives and reporters for browser and node runtimes.",
  "keywords": [
    "instrumentation",
    "observability",
    "performance",
    "tracing",
    "typescript"
  ],
  "homepage": "https://github.com/MrFlashAccount/react-19-query-demo#readme",
  "bugs": {
    "url": "https://github.com/MrFlashAccount/react-19-query-demo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrFlashAccount/react-19-query-demo.git",
    "directory": "lib/tracing"
  },
  "files": [
    "dist",
    "LICENSE*",
    "README*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./async-context": {
      "types": "./dist/async-context.d.ts",
      "default": "./dist/async-context.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:dts",
    "build:lib": "tsdown",
    "build:dts": "tsgo --emitDeclarationOnly -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write"
  },
  "devDependencies": {
    "@lib/brand": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "lit-html": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
