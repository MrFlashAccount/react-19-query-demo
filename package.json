{
  "name": "react-vite-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/dev:.*/\"",
    "dev:watch": "vite",
    "dev:sw": "vite build --config vite.config.sw.ts --watch",
    "dev:perf": "bunx --bun vite --config lib/performance-monitor/test/vite.config.ts",
    "dev:rsc": "bunx --bun vite --config lib/rsc-service-worker-bff/test/vite.config.ts",
    "build": "pnpm run build:sw && bunx --bun vite build",
    "build:sw": "bunx --bun vite build --config vite.config.sw.ts",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit --isolatedDeclarations",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write",
    "preview": "bunx --bun vite preview",
    "test": "bunx --bun vitest",
    "test:ui": "bunx --bun vitest --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-query-devtools": "5.90.2",
    "lit-html": "3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-github-corner": "2.5.0",
    "react-lag-radar": "1.0.0",
    "react-server-dom-webpack": "^19.1.0",
    "web-streams-polyfill": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@toolwind/anchors": "1.0.10",
    "@types/node": "^22.10.5",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260122.3",
    "@vitejs/plugin-react": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "oxlint-tsgolint": "0.11.1",
    "tailwindcss": "4.1.17",
    "vite": "8.0.0-beta.0",
    "vitest": "4.0.9"
  },
  "schema": "https://json.schemastore.org/package"
}