{
  "name": "react-vite-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/dev:.*/\"",
    "dev:watch": "vite",
    "build": "bunx --bun vite build",
    "build:lib": "pnpm -r --filter \"./lib/*\" build",
    "check": "pnpm run \"/check:.*/\"",
    "check:type": "tsgo --noEmit --isolatedDeclarations",
    "check:lint": "oxlint --fix --type-aware",
    "check:format": "oxfmt --write",
    "preview": "bunx --bun vite preview",
    "test": "pnpm -r --filter \"./examples/*\" test",
    "test:ui": "pnpm -r --filter \"./examples/*\" test:ui",
    "test:e2e": "pnpm -r --filter \"./examples/*\" test:e2e",
    "test:e2e:ui": "pnpm -r --filter \"./examples/*\" test:e2e:ui"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@rollup/plugin-babel": "6.1.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@toolwind/anchors": "1.0.10",
    "@types/node": "^22.10.5",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/react-is": "19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260122.3",
    "@vitejs/plugin-react": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "oxlint-tsgolint": "0.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.1.17",
    "tsdown": "0.20.1",
    "typescript": "5.9.3",
    "vite": "8.0.0-beta.0",
    "vitest": "4.0.9"
  },
  "schema": "https://json.schemastore.org/package"
}
