{
  "name": "react-vite-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=./examples/*",
    "dev:movies-db": "pnpm run dev:movies-db:setup && (pnpm run dev:movies-db:watch & pnpm --filter movies-db dev:app)",
    "dev:movies-db:setup": "turbo run build --filter=movies-db^...",
    "dev:movies-db:watch": "turbo watch build --filter=movies-db^... --only --continue=always",
    "dev:dashboard": "pnpm --filter @examples/monitoring-dashboard dev",
    "dev:watch": "vite",
    "build": "turbo run build --filter=./lib/* --filter=./examples/* && pnpm run build:app",
    "build:app": "bunx --bun vite build",
    "build:dashboard": "pnpm --filter @examples/monitoring-dashboard build",
    "build:vercel:single": "node scripts/build-vercel-single.mjs",
    "build:lib": "turbo run build --filter=./lib/*",
    "build:examples": "turbo run build --filter=./examples/*",
    "check": "turbo run check --filter=./lib/* --filter=./examples/* && pnpm run check:type",
    "check:type": "tsgo --noEmit --isolatedDeclarations",
    "check:type:ws": "turbo run check:type --filter=./lib/* --filter=./examples/*",
    "check:lint": "oxlint --fix --type-aware",
    "check:lint:ci": "oxlint --type-aware --deny-warnings --ignore-pattern \"lib/*/dist/**\" lib",
    "check:format": "oxfmt --write",
    "check:format:ci": "oxfmt --check --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml turbo.json .github/workflows/ci-libs.yml .github/workflows/release-libs.yml lib/*/package.json lib/*/src lib/*/__tests__ lib/*/test lib/*/tsconfig.json lib/*/tsconfig.build.json lib/*/tsdown.config.ts lib/*/vitest.config.ts",
    "ci:libs": "pnpm run check:format:ci && pnpm run check:lint:ci && pnpm turbo run check:type build test --filter=./lib/*",
    "preview": "bunx --bun vite preview",
    "test": "turbo run test --filter=./lib/* --filter=./examples/*",
    "test:lib": "turbo run test --filter=./lib/*",
    "test:ui": "turbo run test:ui --filter=./examples/*",
    "test:e2e": "turbo run test:e2e --filter=./examples/*",
    "test:e2e:ui": "turbo run test:e2e:ui --filter=./examples/*",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish --provenance --access public"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@changesets/cli": "^2.29.5",
    "@rollup/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@toolwind/anchors": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-is": "19.2.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "^2.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "chartgpu-react>chartgpu": "0.2.1"
    }
  },
  "schema": "https://json.schemastore.org/package"
}
